{
  "name": "euroleague-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EuroLeague stats website built from the official EuroLeague box scores.",
  "engines": { "node": ">=20" },
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "update": "node scripts/fetch.mjs && node scripts/build.mjs",
    "demo": "node scripts/make-sample.mjs && node scripts/build.mjs --data data/sample --sample",
    "test": "node --test test/*.test.mjs"
  }
}
